<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The engine talks to other devices on this network and to nothing else.

        CHANGE_WIFI_MULTICAST_STATE is the one that is easy to miss and fatal to
        omit: Android drops multicast packets that are not addressed to the
        device unless something holds a MulticastLock, so mDNS discovery finds
        nothing at all without it. ACCESS_WIFI_STATE is what makes WifiManager,
        and therefore that lock, reachable.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
        Syncing with the app closed.

        `dataSync` is the type this actually is - moving a user's files between
        their own devices - and Android requires the type to be declared both
        here and again when the service goes foreground.

        POST_NOTIFICATIONS is a runtime permission, and asking for it is not a
        formality: the foreground service will run without it, but the ongoing
        notification will not appear, which would leave the engine syncing with
        the screen off and nothing on screen to say so. The switch asks before
        it starts anything.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LocalCloudApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.LocalCloud">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LocalCloud"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
