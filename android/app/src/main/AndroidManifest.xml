<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The engine talks to other devices on this network and to nothing else.

        CHANGE_WIFI_MULTICAST_STATE is the one that is easy to miss and fatal to
        omit: Android drops multicast packets that are not addressed to the
        device unless something holds a MulticastLock, so mDNS discovery finds
        nothing at all without it. ACCESS_WIFI_STATE is what makes WifiManager,
        and therefore that lock, reachable.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
        Syncing with the app closed.

        `dataSync` is the type this actually is - moving a user's files between
        their own devices - and Android requires the type to be declared both
        here and again when the service goes foreground.

        POST_NOTIFICATIONS is a runtime permission, and asking for it is not a
        formality: the foreground service will run without it, but the ongoing
        notification will not appear, which would leave the engine syncing with
        the screen off and nothing on screen to say so. The switch asks before
        it starts anything.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LocalCloudApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.LocalCloud">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LocalCloud"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                §8 of DESIGN.md: on mobile an item is added by the share sheet
                or the Add button. This is the share sheet, and it is what
                `import_file` was written for - its doc comment says so.

                `*/*` because the engine has no opinion about formats. It stores
                bytes and a name, so anything a person can share is something
                this can hold, and narrowing the filter would only refuse files
                for no reason.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
            Not exported and not bindable. Being started is the whole
            instruction, so there is no interface to offer and nothing outside
            this app has any business starting it.
        -->
        <service
            android:name=".service.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            The one way a file leaves this app.

            Not exported: no other app may query it. Access happens only when
            this app puts a URI in an Intent with a read grant, one file and one
            launch at a time, and only for paths named in file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
