<!--
    The status bar icon.

    A monochrome outline, because that is all a notification icon is allowed to
    be: Android throws away every colour and keeps the alpha channel, so a
    launcher icon used here would arrive as a white blob. Same two shapes as the
    Devices glyph in the app, so the thing in the status bar is recognisably the
    thing in the navigation bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M3,6 H14.5 V14 H3 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M8.75,14 V17.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M6.5,17.5 H11"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M17.5,9.5 H21 V18 H17.5 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round" />
</vector>
